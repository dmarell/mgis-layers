# Lantmäteriet STAC-höjd credentials.
# Copy to config/lantmateriet.secret.env and fill in real values.
#
# Markhöjdmodell uses two hosts:
#   api.lantmateriet.se  — STAC search (OAuth or Basic)
#   dl1.lantmateriet.se  — GeoTIFF download (Basic with Geotorget account)
#
# Recommended: keep OAuth for STAC *and* add Basic credentials below.
# Tile downloads use Basic automatically when username/password are set.
#
# Also order "Markhöjdmodell Nedladdning" in Geotorget for the account.

# --- OAuth2 (API Portal application keys) ---
LANTMATERIET_AUTH_METHOD=oauth2
LANTMATERIET_OAUTH_CLIENT_ID=
LANTMATERIET_OAUTH_CLIENT_SECRET=
LANTMATERIET_OAUTH_TOKEN_URL=https://apimanager.lantmateriet.se/oauth2/token
LANTMATERIET_OAUTH_SCOPE=
LANTMATERIET_OAUTH_AUTH_STYLE=basic

# --- Basic auth (Geotorget systemkonto, or privatperson Geotorget login) ---
# Required for tile download from dl1.lantmateriet.se (403 without this).
LANTMATERIET_STAC_USERNAME=
LANTMATERIET_STAC_PASSWORD=

# Optional STAC base URL (default is fine; do not use special characters in host)
# LANTMATERIET_STAC_URL=https://api.lantmateriet.se/stac-hojd/v1
